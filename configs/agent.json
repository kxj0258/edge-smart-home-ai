{
  "enabled": true,
  "provider": "ollama",
  "max_commands": 8,
  "ollama": {
    "endpoint": "http://127.0.0.1:11434/api/generate",
    "model": "qwen3:4b",
    "connect_timeout_seconds": 2.0,
    "total_timeout_seconds": 30.0,
    "max_output_tokens": 256,
    "temperature": 0.0,
    "seed": 42,
    "think": false,
    "keep_alive": "10m"
  },
  "rules": [
    {
      "exact": ["你好", "嗨", "hello"],
      "kind": "response",
      "message": "你好，我是小兴。"
    },
    {
      "exact": ["你是谁"],
      "kind": "response",
      "message": "我是小兴，可以控制和查询家庭设备。"
    },
    {
      "contains_all": ["客厅", "暗"],
      "kind": "plan",
      "message": "客厅光线较暗，计划打开客厅灯。",
      "commands": [
        {"device_id": "living_room_light", "action": "turn_on"}
      ]
    },
    {
      "contains_all": ["有点暗"],
      "kind": "clarification",
      "message": "请问需要打开哪个房间的灯？"
    }
  ]
}
