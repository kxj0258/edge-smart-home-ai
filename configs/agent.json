{
  "enabled": true,
  "provider": "rule_based",
  "max_commands": 8,
  "rules": [
    {
      "exact": ["你好", "嗨", "hello"],
      "kind": "response",
      "message": "你好，我是本地智慧家庭助手。"
    },
    {
      "exact": ["你是谁"],
      "kind": "response",
      "message": "我是 Edge AI Smart Home Assistant PoC，简单设备命令由本地 Fast Path 执行。"
    },
    {
      "contains_all": ["客厅", "暗"],
      "kind": "plan",
      "message": "客厅光线较暗，计划打开客厅灯。",
      "commands": [
        {"device_id": "living_room_light", "action": "turn_on"}
      ]
    },
    {
      "contains_all": ["有点暗"],
      "kind": "clarification",
      "message": "请问需要打开哪个房间的灯？"
    }
  ]
}
